#: src/kgx-close-dialog.c:73
msgid "Close Window?"
msgstr "Pəncərəni bağlamaq?"

#: src/kgx-close-dialog.c:75
msgid ""
"A command is still running, closing this window will kill it and may lead to "
"unexpected outcomes"
msgid_plural ""
"Some commands are still running, closing this window will kill them and may "
"lead to unexpected outcomes"
msgstr[0] ""
"Əmr hələ də işləyir, bu pəncərəni bağlamaq onu dayandıracaq və gözlənilməz "
"nəticələrə səbəb ola bilər"
msgstr[1] ""
"Bəzi əmrlər hələ də işləyir, bu pəncərəni bağlamaq onları dayandıracaq və "
"gözlənilməz nəticələrə səbəb ola bilər"

#: src/kgx-close-dialog.c:82
msgid "Close Tab?"
msgstr "Vərəqi bağlamaq?"

#: src/kgx-close-dialog.c:84
msgid ""
"A command is still running, closing this tab will kill it and may lead to "
"unexpected outcomes"
msgid_plural ""
"Some commands are still running, closing this tab will kill them and may "
"lead to unexpected outcomes"
msgstr[0] ""
"Əmr hələ də işləyir, bu vərəqi bağlamaq onu dayandıracaq və gözlənilməz "
"nəticələrə səbəb ola bilər"
msgstr[1] ""
"Bəzi əmrlər hələ də işləyir, bu vərəqi bağlamaq onları dayandıracaq və "
"gözlənilməz nəticələrə səbəb ola bilər"

